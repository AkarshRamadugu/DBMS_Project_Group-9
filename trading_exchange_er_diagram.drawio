fontSize=11;fontStyle=0;" vertex="1" parent="audit_log"><mxGeometry y="82" width="250" height="26" as="geometry"/></mxCell><mxCell id="audit_log_r3" value="action  INSERT | UPDATE | DELETE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;" vertex="1" parent="audit_log"><mxGeometry y="108" width="250" height="26" as="geometry"/></mxCell><mxCell id="audit_log_r4" value="old_values  (JSONB)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;" vertex="1" parent="audit_log"><mxGeometry y="134" width="250" height="26" as="geometry"/></mxCell><mxCell id="audit_log_r5" value="new_values  (JSONB)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;" vertex="1" parent="audit_log"><mxGeometry y="160" width="250" height="26" as="geometry"/></mxCell><mxCell id="audit_log_r6" value="changed_at  DEFAULT now()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;" vertex="1" parent="audit_log"><mxGeometry y="186" width="250" height="26" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;- options is a disjoint specialization (ISA) of instruments; a trigger ensures only instruments of type OPTION get an options row.&lt;br&gt;- A trigger checks that each trade pairs one BUY and one SELL order for the same instrument.&lt;br&gt;- positions.qty and accounts.cash_balance are deliberate denormalization, kept correct inside the settlement transaction.&lt;br&gt;- audit_log has no foreign keys on purpose, so history survives deletes. It is filled by triggers.&lt;br&gt;- Stocks-only version: delete the options table and the two instruments-options edges.&lt;br&gt;- Colors: blue = identity, green = instruments and market data, orange = trading, gray = audit." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="760" width="630" height="170" as="geometry"/></mxCell><mxCell id="e1" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="accounts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="accounts" target="cash_ledger"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="places" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="accounts" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="holds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=10;labelBack